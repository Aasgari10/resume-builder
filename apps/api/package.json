{
  "name": "@rb/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test src/lib/lib.test.ts src/lib/subdomain.test.ts src/render/sitePage.test.tsx src/render/templates.test.tsx src/payments/zarinpal.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:grant": "tsx scripts/grant-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.1.0",
    "@prisma/client": "^6.0.0",
    "@rb/schema": "*",
    "@rb/templates": "*",
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^6.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20.12"
  }
}
