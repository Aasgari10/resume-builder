// Database schema.
// Tenancy: every user-owned row carries userId; queries are always scoped by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────

enum Role {
  USER
  ADMIN // platform operator
}

enum Locale {
  fa
  en
}

enum TemplateKind {
  PDF // printable resume
  PORTFOLIO // hosted portfolio website
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum OrderItemType {
  TEMPLATE // premium template purchase (unlocks use and HTML download)
  HOSTING // hosting subscription (planned)
}

enum TransactionStatus {
  PENDING // created; user redirected to the payment gateway
  SUCCESS // verified with the gateway
  FAILED
}

enum PaymentScope {
  PLATFORM // payment to the platform (template sales)
  TENANT // payment to a customer through their own gateway (planned)
}

// ───────────── Users and auth ─────────────

model User {
  id        String   @id @default(cuid())
  phone     String   @unique // login identifier (OTP)
  name      String?
  email     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes         Resume[]
  sites           Site[]
  orders          Order[]
  purchases       TemplatePurchase[]
  paymentGateways PaymentGateway[]
  downloadTokens  DownloadToken[]
  aiUsages        AiUsage[]
  uploads         Upload[]
  siteOrders      SiteOrder[]
  supportTickets  SupportTicket[]
  templateComments TemplateComment[]
  commentVotes     TemplateCommentVote[]
}

// One-time login code. Keyed by phone rather than User, since first-time users do not exist yet.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String // HMAC of the code; the code itself is never stored
  attempts   Int       @default(0) // failed verification attempts
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ───────────── Resumes ─────────────

model Resume {
  id             String   @id @default(cuid())
  userId         String
  title          String // user-facing label in the dashboard
  locale         Locale   @default(fa) // mirrors data.locale
  data           Json // resume content; validated by resumeDraftSchema on write
  portfolioTheme Json? // themeSchema; editor's working theme for the portfolio site
  pdfTheme       Json? // themeSchema; settings of the last PDF export
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  site       Site?
  siteOrders SiteOrder[]

  @@index([userId])
}

// ───────────── Templates ─────────────

model Template {
  id           String       @id // readable slug, e.g. "minimal-portfolio"
  name         String
  kind         TemplateKind
  isPremium    Boolean      @default(false)
  price        Int          @default(0) // rials; 0 for free templates
  previewImage String?
  supports     Json? // theme options this template supports (e.g. colorMode)
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  sites      Site[]
  purchases  TemplatePurchase[]
  orderItems Order[]
}

// ───────────── Portfolio sites ─────────────

// One site per resume. Public pages render the published snapshot, never the live draft,
// so edits reach the site only when the user publishes again.
model Site {
  id             String    @id @default(cuid())
  userId         String
  resumeId       String    @unique
  templateId     String
  subdomain      String    @unique // <subdomain>.<platform domain>
  customDomain   String?   @unique // customer-owned domain (planned)
  paymentLink    String? // external payment link shown as a button
  seoTitle       String? // overrides the generated <title>
  seoDescription String? // overrides the generated meta description
  noindex        Boolean   @default(false) // asks search engines not to index the site
  publishedData  Json? // resumeDataSchema snapshot taken at publish time
  publishedTheme Json? // themeSchema snapshot taken at publish time
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume   Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])

  downloadTokens DownloadToken[]
  shopOrders     ShopOrder[]
  shopCustomers  ShopCustomer[]
  shopReviews    ShopReview[]
  shopTickets    ShopTicket[]
  messages       SiteMessage[]

  @@index([userId])
}

// ───────────── Shop orders ─────────────

// An order placed by a visitor on a published shop site. Prices are copied from the published
// products at order time, so later price changes do not alter past orders.
model ShopOrder {
  id           String          @id @default(cuid())
  siteId       String
  code         String          @unique // short tracking code shown to the customer
  status       ShopOrderStatus @default(NEW)
  customerName String
  phone        String
  city         String?
  address      String
  postalCode   String?
  note         String?
  items        Json // [{ id, name, size, qty, unit, total }]
  subtotal     Int // tomans
  discount     Int             @default(0) // taken off by a discount code
  couponCode   String?
  shipping     Int
  total        Int
  customerId   String? // set when a signed-in customer ordered
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime? // in the panel's trash since then (hidden everywhere); removed for good after 30 days

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer ShopCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([customerId])
}

// A customer account of one shop (each shop has its own customers).
model ShopCustomer {
  id           String    @id @default(cuid())
  siteId       String
  name         String
  phone        String // Iranian mobile number, the login name
  passwordHash String
  addresses    Json      @default("[]") // [{ id, title, city, address, postalCode }]
  createdAt    DateTime  @default(now())
  deletedAt    DateTime? // in the panel's trash since then (hidden everywhere); removed for good after 30 days

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  orders   ShopOrder[]
  reviews  ShopReview[]
  tickets  ShopTicket[]
  messages SiteMessage[]

  @@unique([siteId, phone])
}

// A customer's rating and comment on a product; shown once the shop approves it.
model ShopReview {
  id         String    @id @default(cuid())
  siteId     String
  productId  String
  customerId String
  rating     Int // 1..5
  text       String
  approved   Boolean   @default(false)
  reply      String? // the shop's answer
  createdAt  DateTime  @default(now())
  deletedAt  DateTime? // in the panel's trash since then (hidden everywhere); removed for good after 30 days

  site     Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer ShopCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([siteId, productId])
}

// A support conversation between a customer and the shop.
model ShopTicket {
  id         String           @id @default(cuid())
  siteId     String
  customerId String
  subject    String
  status     ShopTicketStatus @default(OPEN)
  messages   Json             @default("[]") // [{ from: "customer" | "shop", text, at }]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime? // in the panel's trash since then (hidden everywhere); removed for good after 30 days

  site     Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer ShopCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([siteId, updatedAt])
}

enum ShopTicketStatus {
  OPEN // waiting for the shop
  ANSWERED // the shop replied
  CLOSED
}

enum ShopOrderStatus {
  NEW
  CONFIRMED
  SENT
  DONE
  CANCELED
}

// ───────────── What visitors send through a site's forms ─────────────

// A booking (salon appointment, restaurant table), a contact message or a newsletter sign-up, sent
// through a form of a published site; the owner sees and manages them in the panel's inbox.
model SiteMessage {
  id         String            @id @default(cuid())
  siteId     String
  kind       SiteMessageKind
  status     SiteMessageStatus @default(NEW)
  code       String?           @unique // tracking code of a booking, shown to the visitor
  name       String?
  phone      String?
  email      String?
  subject    String?
  text       String?
  service    String? // the chosen service of a booking
  date       String? // as the visitor entered it (yyyy-mm-dd)
  time       String? // hh:mm
  guests     Int?
  nights     Int? // a guesthouse stay: nights from the check-in day (date)
  page       String? // the page the form was sent from
  ownerNote  String? // the owner's own note, never shown to the visitor
  customerId String? // the site's signed-in customer who sent it (their "my bookings")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime? // in the panel's trash since then; removed for good after 30 days

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer ShopCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([siteId, kind, createdAt])
  @@index([customerId])
}

enum SiteMessageKind {
  BOOKING
  CONTACT
  NEWSLETTER
}

enum SiteMessageStatus {
  NEW
  SEEN // read (a message) or under review (a booking)
  CONFIRMED // a booking the owner accepted
  DONE
  CANCELED
}

// ───────────── Template ownership ─────────────

// Created when an order is paid. Download access is checked against this table only.
model TemplatePurchase {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  orderId    String   @unique
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@unique([userId, templateId]) // a template is purchased at most once per user
}

// ───────────── Orders and payments ─────────────

model Order {
  id         String        @id @default(cuid())
  userId     String
  itemType   OrderItemType
  templateId String?
  amount     Int // rials; copied from the template price at order time
  status     OrderStatus   @default(PENDING)
  createdAt  DateTime      @default(now())
  paidAt     DateTime?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     Template?         @relation(fields: [templateId], references: [id])
  transactions Transaction[]
  purchase     TemplatePurchase?

  @@index([userId])
}

model Transaction {
  id         String            @id @default(cuid())
  orderId    String
  scope      PaymentScope      @default(PLATFORM)
  provider   String // zarinpal | zibal | idpay ...
  authority  String            @unique // gateway reference; unique to prevent double verification
  amount     Int // source of truth for verification, never the callback payload
  status     TransactionStatus @default(PENDING)
  refId      String? // bank reference after success
  raw        Json? // raw gateway response, for debugging
  createdAt  DateTime          @default(now())
  verifiedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Customer-owned payment gateway credentials (planned).
model PaymentGateway {
  id                  String   @id @default(cuid())
  userId              String
  provider            String
  merchantIdEncrypted String // encrypted at rest
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ───────────── Downloads ─────────────

// Single-use, expiring link for downloading a site as a standalone HTML file.
model DownloadToken {
  id        String    @id @default(cuid())
  token     String    @unique // long random string
  userId    String
  siteId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────── AI assistant ─────────────

// One row per model call; daily budgets are enforced by summing totalTokens.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  ok               Boolean // false when the model reply could not be used
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ───────────── Platform settings ─────────────

// Key-value settings editable from the admin panel; values are validated in code.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────── Uploads ─────────────

// Files users upload (profile photos). Stored on disk; this table tracks ownership and quota.
// Files are kept even if no longer referenced, since published snapshots may still point to them.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  fileName  String   @unique // random name under UPLOAD_DIR
  mimeType  String
  size      Int // bytes
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────── Waitlist ─────────────

// Visitors asking to be notified when a product launches, or to be called for a consultation.
model WaitlistEntry {
  id        String   @id @default(cuid())
  product   String // e.g. "salon", "shop", "consult"
  phone     String
  createdAt DateTime @default(now())

  @@unique([product, phone])
  @@index([product, createdAt])
}

// ───────────── Site build orders ─────────────

// A customer asks the platform to build the site they shaped in the editor (catalog mode: customers do
// not publish themselves). The order keeps a copy of the design as it was when ordered, so later edits
// in the editor do not change what was ordered. Both sides talk in the order's thread.
model SiteOrder {
  id            String          @id @default(cuid())
  code          String          @unique // tracking code shown to the customer, e.g. S482913
  userId        String
  resumeId      String? // the editor document it was ordered from; kept if that document is deleted
  templateId    String
  title         String // the document's title at order time
  name          String
  phone         String
  business      String?
  note          String?
  design        Json // { data, theme } at order time
  status        SiteOrderStatus @default(NEW)
  messages      Json            @default("[]") // [{ from: "customer" | "admin", text, at }]
  unreadByUser  Boolean         @default(false) // the admin wrote or changed the status since the customer last looked
  unreadByAdmin Boolean         @default(true) // new, or the customer wrote since the admin last looked
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum SiteOrderStatus {
  NEW // just placed
  REVIEWING // the team is looking at it
  BUILDING
  DELIVERED
  CANCELED
}

// ───────────── Support tickets ─────────────

// A support conversation between a signed-in customer and the site4site team, opened from the support
// page. The admin can switch new tickets off (setting "ticketsEnabled"); open tickets carry on.
model SupportTicket {
  id            String              @id @default(cuid())
  code          String              @unique // shown to the customer, e.g. T482913
  userId        String
  topic         SupportTopic
  subject       String
  orderCode     String? // the site order it is about, when there is one
  status        SupportTicketStatus @default(OPEN)
  messages      Json                @default("[]") // [{ from: "customer" | "admin", text, at }]
  unreadByUser  Boolean             @default(false) // the team answered since the customer last looked
  unreadByAdmin Boolean             @default(true) // new, or the customer wrote since the admin last looked
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

enum SupportTopic {
  ORDER // a site order
  TECHNICAL // a problem with a site or the panel
  BILLING // payments and invoices
  OTHER
}

enum SupportTicketStatus {
  OPEN // waiting for the team
  ANSWERED // the team replied
  CLOSED
}

// ───────────── Template comments ─────────────

// What visitors say about a site template on the templates page. Signed-in users write and vote (like or
// dislike); only an admin answers, and an admin can remove a comment.
model TemplateComment {
  id         String    @id @default(cuid())
  templateId String // a site template id from @rb/templates
  userId     String
  text       String
  reply      String? // the admin's answer
  repliedAt  DateTime?
  likes      Int       @default(0)
  dislikes   Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime? // removed by an admin (hidden everywhere)

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes TemplateCommentVote[]

  @@index([templateId, createdAt])
  @@index([reply, createdAt])
}

// One user's like (1) or dislike (-1) on a comment.
model TemplateCommentVote {
  commentId String
  userId    String
  value     Int

  comment TemplateComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}
