# Copy to .env and adjust values.

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_builder"

PORT=4000

# Session signing key, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Outside production, return OTP codes in API responses so login works without SMS.
OTP_DEV_ECHO=true

# Root domain for site subdomains: sites are served at <subdomain>.<ROOT_DOMAIN>.
# Use "localhost" in development (http://sara.localhost:4000); leave empty to use /s/<subdomain> only.
ROOT_DOMAIN="localhost"

# Public origin of the web app; the payment gateway returns the user here.
APP_URL="http://localhost:5173"

# Payment gateway: "fake" (local test page, development only) or "zarinpal".
PAYMENT_PROVIDER="fake"
# Required for zarinpal. Set ZARINPAL_SANDBOX=true to use the sandbox gateway.
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX=false

# AI appearance assistant: any OpenAI-compatible chat completions API.
# Leave AI_API_KEY empty to use the local fake model in development (disabled in production).
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
# Set to true to request response_format JSON mode; off by default since some
# reasoning models stall with it. Replies are parsed and validated either way.
AI_JSON_MODE=false
